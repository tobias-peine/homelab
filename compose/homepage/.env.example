# NPM-API (nur für die Einrichtung von Access List und Proxy Host nötig)
NPM_URL=http://<NPM_CONTAINER_IP>:81
NPM_USER=<NPM_ADMIN_MAIL>
NPM_PASS=<NPM_ADMIN_PASSWORT>

# Dashboard-Login, wird in der NPM-Access-List "dash-auth" gesetzt
DASH_USER=admin
DASH_PASS=<ZUFALL>
DASH_HOST=dash.<DEINE_DOMAIN>

# Widget-Zugänge, nur lesend, werden in services.yaml per {{HOMEPAGE_VAR_...}} referenziert
HOMEPAGE_VAR_PAPERLESS_TOKEN=<PAPERLESS_API_TOKEN>
HOMEPAGE_VAR_N8N_KEY=<N8N_API_KEY>
HOMEPAGE_VAR_GHOST_KEY=<GHOST_CONTENT_API_KEY>
