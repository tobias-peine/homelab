# Vorlage für .env – kopieren, Werte eintragen, niemals committen.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Fehlt ein Pflichtwert, bricht `docker compose up` ab, statt mit einem
# leeren Passwort zu starten.

# Öffentliche URL des Blogs. Im Repo steht bewusst nur ein Platzhalter.
GHOST_URL=https://<DEINE_DOMAIN>

# Datenbank – zwei verschiedene, lange Zufallswerte.
# Erzeugen z. B. mit:  openssl rand -base64 32
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Mailversand (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=<DEINE_MAIL>
